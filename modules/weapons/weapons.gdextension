[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]
windows.debug.x86_64 = "res://modules/weapons/bin/windows/debug/weapons_gd.dll"
windows.release.x86_64 = "res://modules/weapons/bin/windows/release/weapons_gd.dll"
windows.debug.arm64 = "res://modules/weapons/bin/windows/debug/weapons_gd.dll"
windows.release.arm64 = "res://modules/weapons/bin/windows/release/weapons_gd.dll"
linux.debug.x86_64 = "res://modules/weapons/bin/linux/debug/libweapons_gd.so"
linux.release.x86_64 = "res://modules/weapons/bin/linux/release/libweapons_gd.so"
linux.debug.arm64 = "res://modules/weapons/bin/linux/debug/libweapons_gd.so"
linux.release.arm64 = "res://modules/weapons/bin/linux/release/libweapons_gd.so"
macos.debug = "res://modules/weapons/bin/macos/debug/libweapons_gd.dylib"
macos.release = "res://modules/weapons/bin/macos/release/libweapons_gd.dylib"
