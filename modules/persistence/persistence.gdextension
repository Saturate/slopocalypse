[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]
windows.debug.x86_64 = "res://modules/persistence/bin/windows/debug/persistence_gd.dll"
windows.release.x86_64 = "res://modules/persistence/bin/windows/release/persistence_gd.dll"
windows.debug.arm64 = "res://modules/persistence/bin/windows/debug/persistence_gd.dll"
windows.release.arm64 = "res://modules/persistence/bin/windows/release/persistence_gd.dll"
linux.debug.x86_64 = "res://modules/persistence/bin/linux/debug/libpersistence_gd.so"
linux.release.x86_64 = "res://modules/persistence/bin/linux/release/libpersistence_gd.so"
linux.debug.arm64 = "res://modules/persistence/bin/linux/debug/libpersistence_gd.so"
linux.release.arm64 = "res://modules/persistence/bin/linux/release/libpersistence_gd.so"
macos.debug = "res://modules/persistence/bin/macos/debug/libpersistence_gd.dylib"
macos.release = "res://modules/persistence/bin/macos/release/libpersistence_gd.dylib"
