class_name SceneryScatter
extends Node3D
## Trees, rocks, grass and the road, generated by code and streamed in chunks around whoever
## needs them. The world is long, so nothing is placed up front: each 64 m chunk along the
## road is laid out from its own seed when someone comes near and freed when everyone has
## left, so the server and every client get the same trees in the same places.
##
## The server builds only collision (tree trunks, rock hulls) around players and vehicles.
## Clients also build the visuals around their camera: a few voxel-kit variants of each
## kind, made once and reused through MultiMesh, a coarse version of each tree for distance,
## grass close by, and the road's voxel pieces.

@export_file("*.json") var config_path: String = "res://modules/world/data/world.json"

const REQUIRED := {"seed": TYPE_FLOAT, "trees_per_hectare": TYPE_FLOAT, "rocks_per_hectare": TYPE_FLOAT, "grass_per_m2": TYPE_FLOAT, "clear_radius": TYPE_FLOAT, "max_steepness": TYPE_FLOAT, "road_clearance": TYPE_FLOAT, "load_distance": TYPE_FLOAT, "collision_distance": TYPE_FLOAT, "grass_distance": TYPE_FLOAT, "tree_detail_distance": TYPE_FLOAT, "variants": TYPE_FLOAT, "tree_hits": TYPE_FLOAT, "tree_blast_reach": TYPE_FLOAT, "tree_fall_seconds": TYPE_FLOAT, "tree_collapse": TYPE_FLOAT, "tree_wither_seconds": TYPE_FLOAT}

const CHUNK := 64.0
## Chunks split across the width into cells, so distance culling works per cell.
const CELL := 64.0
const GRASS_CELL := 32.0
## Longest road face before it is bent, in metres.
const ROAD_BEND_STEP := 1.0
## The smoothed terrain sags a little past a dug sphere's edge, and the shader shows that
## fringe as dirt, so grass clears slightly wider than the hole.
const GRASS_CLEAR_MARGIN := 0.4
## Chunks built per frame at most, so walking into new ground never stalls a frame for long.
const BUILDS_PER_FRAME := 1
const TREE_NEAR_VOXEL := 0.15
const TREE_FAR_VOXEL := 0.45
const ROCK_VOXEL := 0.1
const ROAD_VOXEL := 0.1
## Length of one road piece, in metres; a chunk's road is cut into these.
const ROAD_PIECE := 8.0
## Room for every piece of a chunk in the road keys (chunk * this + piece).
const ROADS_PER_CHUNK := 64
## How far the road model sits into the ground: its surface ends up 3 cm proud.
const ROAD_LIFT := VoxRoad.BED + VoxRoad.SURFACE - 0.03
## Furthest the road's pieces reach sideways from its centre line (lanes, shoulder, kerb).
const ROAD_REACH := 8.0
## Width of the burnt ring round a crater in the road, and its colour.
const ROAD_SCORCH := 0.35
const ROAD_SCORCH_COLOUR := Color(0.09, 0.085, 0.08)
## Smaller bites taken out round a crater's edge in the road.
const ROAD_RIM_BITES := 7
## A bullet this far outside a trunk's capsule still counts as hitting it (the voxel bark
## sticks out past the capsule).
const TREE_HIT_SLACK := 0.5
const DIRT := Color(0.32, 0.25, 0.17)
const ASPHALT_CHIPS := Color(0.2, 0.2, 0.21)
## Rocks whose top is lower than this above the ground get no collision; feet clear them.
const STEP_OVER_HEIGHT := 0.3
## Trees, rocks and grass keep this far from the start tunnel: the ground over it is the
## trench floor, so anything put there would stand inside the tunnel.
const TUNNEL_CLEARANCE := 2.0

var _heights: TerrainHeights
var _biomes: Biomes
var _cfg: Dictionary
var _seed := 0
var _visual := DisplayServer.get_name() != "headless"
var _chunks: Dictionary[int, Node3D] = {}
## Circles kept free of trees, rocks and grass (where another module puts buildings), as
## (x, z, radius).
var _clearings: Array[Vector3] = []
## Variant lists per kind: {near: Mesh, far: Mesh, height, trunk} for trees,
## {mesh: Mesh, shape: Shape3D, top} for rocks.
var _pines: Array[Dictionary] = []
var _leafs: Array[Dictionary] = []
var _rocks: Array[Dictionary] = []
var _grass_mesh_cached: Mesh
var _grass_cells: Dictionary[Vector2i, MultiMeshInstance3D] = {}
## Every dig so far, so chunks built later leave grass out of old craters too.
var _digs: Array[Vector4] = []
## The same craters listed under every grass cell they (plus the clearing margin) reach,
## so placing a blade looks at a few craters, not all of them.
var _digs_near: Dictionary[Vector2i, Array] = {}
## Per loaded road piece (chunk * ROADS_PER_CHUNK + piece): {model: VoxelModel, mid: float, cx: float, mesh: MeshInstance3D}.
var _roads: Dictionary[int, Dictionary] = {}
## Road chunks dug since the last frame, re-meshed once each in _process.
var _roads_dirty: Dictionary[int, bool] = {}
## Per loaded chunk, its trees in placement order (the same on every machine):
## {at, xform, kind, v, key, slot, trunk, leaves, radius}.
var _trees: Dictionary[int, Array] = {}
## Per loaded chunk, the MultiMesh instances per tree key: {key: [near, far]}.
var _tree_meshes: Dictionary[int, Dictionary] = {}
## Bullets, cuts and falls.
var _damage: TreeDamage
## Chunk plans being worked out on worker threads: chunk -> {task, result (an Array the
## task appends its plan to), clearings (generation they were made with)}.
var _pending: Dictionary[int, Dictionary] = {}
## Bumped whenever the clearings change, so plans made with the old ones are thrown away.
var _clearings_gen := 0


func _ready() -> void:
	var data: Variant = Data.load_json(config_path)
	if not data is Dictionary or not Data.require(config_path, data, TerrainHeights.REQUIRED):
		return
	var world: Dictionary = data
	if not world.has("scatter") or not Data.require(config_path + " scatter", world["scatter"], REQUIRED):
		return
	if not world.has("biomes") or not Data.require(config_path + " biomes", world["biomes"], Biomes.REQUIRED):
		return
	_cfg = world["scatter"]
	_damage = TreeDamage.new()
	_damage.name = "Trees"
	_damage.scatter = self
	_damage.visual = _visual
	_damage.config = _cfg
	add_child(_damage)
	_seed = int(_cfg["seed"])
	_heights = TerrainHeights.new(world)
	_biomes = Biomes.new(world["biomes"], _heights.stages)
	_make_variants()
	# Other modules ask for clearings through this group (`set_clearings`).
	add_to_group(&"scenery")
	# The spawn is ready before anyone arrives (the world waits on its collision).
	update_around([Vector3.ZERO], INF)


func _process(_delta: float) -> void:
	var prof := Prof.start()
	_process_tick(_delta)
	Prof.stop(&"world/scenery_scatter:frame", prof)


func _process_tick(_delta: float) -> void:
	if _heights == null:
		return
	update_around(_focus_points(), BUILDS_PER_FRAME, true)
	for i: int in _roads_dirty:
		if _roads.has(i):
			_mesh_road(_roads[i])
	_roads_dirty.clear()


## Builds chunks near any of `points` (at most `budget` this call) and frees the ones far
## from all of them. With `threaded`, where trees and rocks go is worked out on worker
## threads and a chunk is built from its plan on a later call; otherwise right away.
func update_around(points: Array[Vector3], budget: float, threaded := false) -> void:
	var reach: float = _cfg["load_distance"] if _visual else _cfg["collision_distance"]
	var wanted: Dictionary[int, bool] = {}
	for p in points:
		var first := _chunk_of(p.z + reach)
		var last := _chunk_of(p.z - reach)
		for i in range(maxi(first, 0), mini(last, _chunk_count() - 1) + 1):
			wanted[i] = true
	var built := 0
	# Nearest first, so the ground you stand on is never waiting behind the horizon.
	var order := wanted.keys()
	order.sort_custom(func(a: int, b: int) -> bool: return _nearest(a, points) < _nearest(b, points))
	for i: int in order:
		if _chunks.has(i):
			continue
		if not threaded:
			if built >= budget:
				break
			_chunks[i] = _build_chunk(i, _take_plan(i))
			built += 1
			continue
		if not _pending.has(i):
			_start_plan(i)
			continue
		if built >= budget or not WorkerThreadPool.is_task_completed(int(_pending[i]["task"])):
			continue
		var plan := _take_plan(i, false)
		if plan.is_empty():
			_start_plan(i)
			continue
		_chunks[i] = _build_chunk(i, plan)
		built += 1
	for i: int in _chunks.keys():
		if not wanted.has(i) and _nearest(i, points) > reach + CHUNK:
			_free_chunk(i)
	for i: int in _pending.keys():
		if not wanted.has(i) and WorkerThreadPool.is_task_completed(int(_pending[i]["task"])):
			_take_plan(i, false)


## Starts working out chunk `i`'s plan on a worker thread.
func _start_plan(i: int) -> void:
	var result: Array = []
	var clearings: Array[Vector3] = _clearings.duplicate()
	var task := WorkerThreadPool.add_task(func() -> void: result.append(plan_chunk(i, clearings)), true, "scenery chunk")
	_pending[i] = {"task": task, "result": result, "clearings": _clearings_gen}


## Chunk `i`'s finished plan (waiting for it if it is still running). When there is none or
## it was made with old clearings: a fresh one worked out here, or with `here` false an empty
## one (the caller starts it again on a worker).
func _take_plan(i: int, here := true) -> Dictionary:
	if _pending.has(i):
		var job: Dictionary = _pending[i]
		_pending.erase(i)
		WorkerThreadPool.wait_for_task_completion(int(job["task"]))
		var result: Array = job["result"]
		if int(job["clearings"]) == _clearings_gen and not result.is_empty():
			return result[0]
	return plan_chunk(i, _clearings) if here else {}


func _exit_tree() -> void:
	# Tasks read this node's terrain and config; none may outlive it.
	for i: int in _pending.keys():
		WorkerThreadPool.wait_for_task_completion(int(_pending[i]["task"]))
	_pending.clear()


## Keeps trees, rocks and grass out of `circles` (`[{at: Vector3, radius: float}]`),
## replacing any earlier set; loaded chunks the old or new circles touch are rebuilt. Every
## instance must set the same circles (they change what grows where).
func set_clearings(circles: Array) -> void:
	var before := _clearings.duplicate()
	_clearings_gen += 1
	_clearings.clear()
	for c: Dictionary in circles:
		var at: Vector3 = c["at"]
		_clearings.append(Vector3(at.x, at.z, float(c["radius"])))
	var touched := before + _clearings
	if touched.is_empty():
		return
	for i: int in _chunks.keys():
		var span := _chunk_z(i)
		for c: Vector3 in touched:
			if c.y + c.z > span.x and c.y - c.z < span.y:
				_free_chunk(i)
				_chunks[i] = _build_chunk(i, plan_chunk(i, _clearings))
				break


func _in_clearing(x: float, z: float, clearings: Array[Vector3]) -> bool:
	for c in clearings:
		if Vector2(x - c.x, z - c.y).length() < c.z:
			return true
	return false


func loaded_chunks() -> Array[int]:
	var out: Array[int] = []
	out.assign(_chunks.keys())
	return out


func _focus_points() -> Array[Vector3]:
	var out: Array[Vector3] = []
	if _visual:
		var cam := get_viewport().get_camera_3d()
		if cam != null:
			out.append(cam.global_position)
	# Before a client has connected there is no peer to ask, and nothing to follow yet.
	if multiplayer.has_multiplayer_peer() and multiplayer.is_server():
		for group: StringName in [&"players", &"vehicles"]:
			for n in get_tree().get_nodes_in_group(group):
				if n is Node3D:
					out.append((n as Node3D).global_position)
	if out.is_empty():
		out.append(Vector3.ZERO)
	return out


func _chunk_count() -> int:
	return int(ceil(_heights.length / CHUNK))


## Chunk 0 starts behind the spawn at the near end; numbers grow down the road.
func _chunk_of(z: float) -> int:
	return floori((_heights.z_max() - z) / CHUNK)


func _chunk_z(i: int) -> Vector2:
	var near := _heights.z_max() - i * CHUNK
	return Vector2(near - CHUNK, near)


func _nearest(i: int, points: Array[Vector3]) -> float:
	var span := _chunk_z(i)
	var best := INF
	for p in points:
		best = minf(best, maxf(maxf(span.x - p.z, p.z - span.y), 0.0))
	return best


func _free_chunk(i: int) -> void:
	var node: Node3D = _chunks[i]
	_chunks.erase(i)
	_trees.erase(i)
	_tree_meshes.erase(i)
	for p in ROADS_PER_CHUNK:
		_roads.erase(i * ROADS_PER_CHUNK + p)
		_roads_dirty.erase(i * ROADS_PER_CHUNK + p)
	for key: Vector2i in _grass_cells.keys():
		if _grass_cells[key].get_parent() == node:
			_grass_cells.erase(key)
	node.queue_free()


## A few variants of each kind, built once. The server needs rock hulls only.
func _make_variants() -> void:
	var count := int(_cfg["variants"])
	for v in count:
		var rock := VoxRock.new()
		var p := {"seed": _seed + 500 + v, "width": 1.0 + v * 0.35, "voxel": ROCK_VOXEL}
		var mesh := VoxGenerator.to_mesh(rock.build(p))
		var top := mesh.get_aabb().end.y
		_rocks.append({"mesh": mesh, "shape": mesh.create_convex_shape(true, true), "top": top})
		_pines.append(_tree(VoxPineTree.new(), {"seed": _seed + 100 + v, "height": 8.0 + v * 1.3}))
		_leafs.append(_tree(VoxLeafTree.new(), {"seed": _seed + 300 + v, "height": 6.5 + v * 1.0}))


func _tree(gen: VoxGenerator, p: Dictionary) -> Dictionary:
	var values := gen.with_defaults(p)
	var h := float(values["height"])
	# Crown as (centre height, radius, length) for the sight blocker.
	var crown := Vector3(h * 0.6, float(values.get("width", 0.3)) * h * 0.8, h * 0.75)
	if values.has("crown"):
		var size := float(values["crown"])
		crown = Vector3(h - size * 0.45, size * 0.8, size * 1.4)
	var out := {"height": h, "trunk": float(values["trunk"]), "crown": crown}
	if _visual:
		values["voxel"] = TREE_NEAR_VOXEL
		out["near"] = VoxGenerator.to_mesh(gen.build(values))
		# For rebuilding one tree on its own when it is cut down.
		out["gen"] = gen
		out["values"] = values.duplicate()
		values["voxel"] = TREE_FAR_VOXEL
		out["far"] = VoxGenerator.to_mesh(gen.build(values))
	return out


## Where chunk `i`'s trees and rocks go: pure (terrain, biomes, the chunk's seed and
## `clearings`), so it runs on a worker thread and comes out the same on every machine.
## {trees: [{at, xform, pine, v, scale}], rocks: [{xform, v}], rng_state (where the chunk's
## random sequence is after them, for the grass)}.
func plan_chunk(i: int, clearings: Array[Vector3]) -> Dictionary:
	# No profile zone: Prof is not thread-safe, and the point is that this is off the frame.
	var rng := RandomNumberGenerator.new()
	rng.seed = hash([_seed, i])
	var area := _chunk_area(i)
	return {"trees": _plan_trees(rng, area, clearings), "rocks": _plan_rocks(rng, area, clearings), "rng_state": rng.state}


func _chunk_area(i: int) -> Rect2:
	var span := _chunk_z(i)
	return Rect2(_heights.extent().position.x, span.x, _heights.width, CHUNK)


func _build_chunk(i: int, plan: Dictionary) -> Node3D:
	var t := Prof.start()
	var node := Node3D.new()
	node.name = "Chunk%d" % i
	var rng := RandomNumberGenerator.new()
	rng.seed = hash([_seed, i])
	rng.state = int(plan["rng_state"])
	var span := _chunk_z(i)
	var area := _chunk_area(i)
	var collision := StaticBody3D.new()
	collision.name = "Collision"
	collision.set_meta(&"chunk", i)
	node.add_child(collision)
	# Per kind, variant and cell: the transforms for its MultiMesh.
	var placed: Dictionary = {}
	_add_trees(i, plan["trees"], collision, placed)
	_add_rocks(plan["rocks"], collision, placed)
	# Into the tree only now: hundreds of shapes added to a body already in the physics space
	# are each registered on their own, which costs far more than the body arriving whole.
	add_child(node)
	if _visual:
		var meshes := {}
		for key: Array in placed.keys():
			meshes[key] = _add_instances(node, key, placed[key])
		_tree_meshes[i] = meshes
		_add_grass(node, rng, area)
		_add_road(node, i, span)
	for n in (_trees[i] as Array).size():
		var id := Vector2i(i, n)
		if _damage.is_felled(id):
			_damage.apply(id, false)
	Prof.stop(&"world/scenery_build", t)
	return node


## A spot on gentle ground inside `area`, clear of the spawn and the road, kept with the
## probability `weight(x, z)` gives.
func _spot(rng: RandomNumberGenerator, area: Rect2, weight: Callable, clearings: Array[Vector3]) -> Variant:
	for attempt in 6:
		var x := rng.randf_range(area.position.x + 4.0, area.end.x - 4.0)
		var z := rng.randf_range(area.position.y, area.end.y)
		if Vector2(x, z).length() < float(_cfg["clear_radius"]):
			continue
		if _heights.in_tunnel(x, z, TUNNEL_CLEARANCE):
			continue
		if _heights.road != null and _heights.road.distance(x, z) < _heights.road.half_width + float(_cfg["road_clearance"]):
			continue
		if _in_clearing(x, z, clearings):
			continue
		if rng.randf() > float(weight.call(x, z)):
			continue
		var s := 1.0
		var dx := _heights.height_at(x + s, z) - _heights.height_at(x - s, z)
		var dz := _heights.height_at(x, z + s) - _heights.height_at(x, z - s)
		if Vector2(dx, dz).length() / (2.0 * s) > float(_cfg["max_steepness"]):
			continue
		return Vector3(x, _heights.height_at(x, z), z)
	return null


func _plan_trees(rng: RandomNumberGenerator, area: Rect2, clearings: Array[Vector3]) -> Array[Dictionary]:
	var out: Array[Dictionary] = []
	var tries := int(float(_cfg["trees_per_hectare"]) * area.get_area() / 10000.0)
	var weight := func(x: float, z: float) -> float:
		# Squared so only forest cores are dense; most woodland is open enough to see through.
		return maxf(pow(_biomes.forest(x, z), 2.0), 0.02) * (1.0 - _biomes.rock(x, z) * 0.7)
	for t in tries:
		var spot: Variant = _spot(rng, area, weight, clearings)
		if not spot is Vector3:
			continue
		var at: Vector3 = spot
		# Pines in the deep forest and up the rocky hills, leaf trees in the open.
		var pine := rng.randf() < 0.35 + _biomes.forest(at.x, at.z) * 0.5 + _biomes.rock(at.x, at.z) * 0.3
		var v := rng.randi_range(0, (_pines if pine else _leafs).size() - 1)
		var scale := rng.randf_range(0.8, 1.2)
		var basis := Basis(Vector3.UP, rng.randf() * TAU).scaled(Vector3.ONE * scale)
		out.append({"at": at, "xform": Transform3D(basis, at + Vector3.DOWN * 0.2), "pine": pine, "v": v, "scale": scale})
	return out


func _add_trees(chunk: int, planned: Array, collision: StaticBody3D, placed: Dictionary) -> void:
	var trees: Array[Dictionary] = []
	_trees[chunk] = trees
	for p: Dictionary in planned:
		var at: Vector3 = p["at"]
		var pine: bool = p["pine"]
		var v: int = p["v"]
		var scale: float = p["scale"]
		var tree: Dictionary = (_pines if pine else _leafs)[v]
		var key := ["pine" if pine else "leaf", v, _cell_of(at)]
		var xform: Transform3D = p["xform"]
		var slot := (placed[key] as Array).size() if placed.has(key) else 0
		_put(placed, key, xform)
		var shape := CollisionShape3D.new()
		var capsule := CapsuleShape3D.new()
		capsule.radius = float(tree["trunk"]) * 0.4 * scale
		capsule.height = float(tree["height"]) * 0.6 * scale
		shape.shape = capsule
		shape.position = at + Vector3.UP * capsule.height * 0.5
		collision.add_child(shape)
		# The crown hides you from guards without stopping you or your bullets.
		var crown: Vector3 = tree["crown"]
		var leaves := CollisionShape3D.new()
		var ball := CapsuleShape3D.new()
		ball.radius = crown.y * scale
		ball.height = maxf(crown.z * scale, ball.radius * 2.0)
		leaves.shape = ball
		leaves.position = at + Vector3.UP * crown.x * scale
		_sight_body(collision).add_child(leaves)
		trees.append({"at": at, "xform": xform, "kind": key[0], "v": v, "key": key, "slot": slot, "trunk": shape, "leaves": leaves, "radius": capsule.radius, "trunk_height": float(tree["height"]) * 0.6})


func _plan_rocks(rng: RandomNumberGenerator, area: Rect2, clearings: Array[Vector3]) -> Array[Dictionary]:
	var out: Array[Dictionary] = []
	var tries := int(float(_cfg["rocks_per_hectare"]) * area.get_area() / 10000.0)
	var weight := func(x: float, z: float) -> float:
		return 0.05 + _biomes.rock(x, z) * 0.95
	for t in tries:
		var spot: Variant = _spot(rng, area, weight, clearings)
		if not spot is Vector3:
			continue
		var at: Vector3 = spot
		var v := rng.randi_range(0, _rocks.size() - 1)
		# Rocky ground gets the big boulders.
		var scale := rng.randf_range(0.5, 1.1) + _biomes.rock(at.x, at.z) * rng.randf_range(0.0, 1.2)
		var basis := Basis(Vector3.UP, rng.randf() * TAU).scaled(Vector3.ONE * scale)
		out.append({"xform": Transform3D(basis, at + Vector3.DOWN * 0.1 * scale), "v": v, "scale": scale})
	return out


func _add_rocks(planned: Array, collision: StaticBody3D, placed: Dictionary) -> void:
	for p: Dictionary in planned:
		var xform: Transform3D = p["xform"]
		var v: int = p["v"]
		var scale: float = p["scale"]
		var rock: Dictionary = _rocks[v]
		_put(placed, ["rock", v, _cell_of(xform.origin)], xform)
		# Collision is the rock's own hull; stones lower than a step get none.
		if float(rock["top"]) * scale - 0.1 * scale < STEP_OVER_HEIGHT:
			continue
		var shape := CollisionShape3D.new()
		shape.shape = rock["shape"]
		shape.transform = xform
		collision.add_child(shape)


## The chunk's body for things that only block sight (on PhysicsLayers.SIGHT alone).
func _sight_body(collision: StaticBody3D) -> StaticBody3D:
	var existing := collision.get_parent().get_node_or_null("SightBlockers") as StaticBody3D
	if existing != null:
		return existing
	var body := StaticBody3D.new()
	body.name = "SightBlockers"
	body.collision_layer = PhysicsLayers.SIGHT
	body.collision_mask = 0
	collision.get_parent().add_child(body)
	return body


func _cell_of(at: Vector3) -> Vector2i:
	return Vector2i(floori(at.x / CELL), floori(at.z / CELL))


func _put(placed: Dictionary, key: Array, xform: Transform3D) -> void:
	if not placed.has(key):
		placed[key] = []
	(placed[key] as Array).append(xform)


## One MultiMesh per kind, variant and cell; trees get a detailed copy near and a coarse
## one far.
func _add_instances(node: Node3D, key: Array, transforms: Array) -> Array:
	var kind: String = key[0]
	var v: int = key[1]
	var cell: Vector2i = key[2]
	var centre := Vector3((cell.x + 0.5) * CELL, 0.0, (cell.y + 0.5) * CELL)
	var detail: float = _cfg["tree_detail_distance"]
	if kind == "rock":
		var rock := _multimesh(node, _rocks[v]["mesh"], transforms, [], centre)
		rock.visibility_range_end = float(_cfg["load_distance"])
		return []
	var tree: Dictionary = (_pines if kind == "pine" else _leafs)[v]
	var near := _multimesh(node, tree["near"], transforms, [], centre)
	near.visibility_range_end = detail
	near.visibility_range_end_margin = 8.0
	var far := _multimesh(node, tree["far"], transforms, [], centre)
	far.visibility_range_begin = detail
	far.visibility_range_begin_margin = 8.0
	far.visibility_range_end = float(_cfg["load_distance"]) + CHUNK
	return [near, far]


## Instances are stored relative to `centre`, where the node sits, so visibility ranges are
## measured from the cell rather than the world origin.
func _multimesh(node: Node3D, mesh: Mesh, transforms: Array, colours: Array, centre: Vector3) -> MultiMeshInstance3D:
	var mm := MultiMesh.new()
	mm.transform_format = MultiMesh.TRANSFORM_3D
	mm.use_colors = not colours.is_empty()
	mm.mesh = mesh
	mm.instance_count = transforms.size()
	var to_local := Transform3D(Basis.IDENTITY, -centre)
	for i in transforms.size():
		mm.set_instance_transform(i, to_local * (transforms[i] as Transform3D))
		if mm.use_colors:
			mm.set_instance_color(i, colours[i])
	var inst := MultiMeshInstance3D.new()
	inst.multimesh = mm
	inst.position = centre
	node.add_child(inst)
	return inst


func _add_grass(node: Node3D, rng: RandomNumberGenerator, area: Rect2) -> void:
	if _grass_mesh_cached == null:
		_grass_mesh_cached = _grass_mesh()
	var per_cell: Dictionary[Vector2i, Array] = {}
	var count := int(float(_cfg["grass_per_m2"]) * area.get_area())
	for i in count:
		var x := rng.randf_range(area.position.x, area.end.x)
		var z := rng.randf_range(area.position.y, area.end.y)
		# Thick in meadows, thin on the forest floor, on rock and never on the road.
		var keep := 1.0 - _biomes.forest(x, z) * 0.8 - _biomes.rock(x, z) * 0.6
		if rng.randf() > keep:
			continue
		if _heights.road != null and _heights.road.distance(x, z) < _heights.road.half_width + 0.5:
			continue
		if _heights.in_tunnel(x, z, TUNNEL_CLEARANCE):
			continue
		if _in_clearing(x, z, _clearings):
			continue
		var at := Vector3(x, _heights.height_at(x, z), z)
		if _in_old_dig(at):
			continue
		var s := rng.randf_range(0.5, 1.1)
		var xform := Transform3D(Basis(Vector3.UP, rng.randf() * TAU).scaled(Vector3(s, s * rng.randf_range(0.7, 1.4), s)), at)
		var green := Color(0.3, 0.36, 0.18).lerp(Color(0.44, 0.45, 0.25), rng.randf())
		var colour := green.lerp(Color(0.62, 0.55, 0.32), _biomes.dry(x, z) * 0.85)
		var cell := Vector2i(floori(x / GRASS_CELL), floori(z / GRASS_CELL))
		if not per_cell.has(cell):
			per_cell[cell] = [[], []]
		(per_cell[cell][0] as Array).append(xform)
		(per_cell[cell][1] as Array).append(colour)
	for cell: Vector2i in per_cell.keys():
		var centre := Vector3((cell.x + 0.5) * GRASS_CELL, 0.0, (cell.y + 0.5) * GRASS_CELL)
		var inst := _multimesh(node, _grass_mesh_cached, per_cell[cell][0], per_cell[cell][1], centre)
		inst.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		# Grass far away is noise; fade it out with distance to keep the horizon clean.
		inst.visibility_range_end = float(_cfg["grass_distance"])
		inst.visibility_range_end_margin = 10.0
		inst.visibility_range_fade_mode = GeometryInstance3D.VISIBILITY_RANGE_FADE_SELF
		_grass_cells[cell] = inst


func _in_old_dig(at: Vector3) -> bool:
	for d: Vector4 in _digs_near.get(Vector2i(floori(at.x / GRASS_CELL), floori(at.z / GRASS_CELL)), []):
		if at.distance_to(Vector3(d.x, d.y, d.z)) < d.w + GRASS_CLEAR_MARGIN:
			return true
	return false


## Removes the grass a dug sphere took the ground out from under, so it doesn't float.
func clear_grass(center: Vector3, radius: float) -> void:
	var dig := Vector4(center.x, center.y, center.z, radius)
	_digs.append(dig)
	var reach := radius + GRASS_CLEAR_MARGIN
	var low := Vector2i(floori((center.x - reach) / GRASS_CELL), floori((center.z - reach) / GRASS_CELL))
	var high := Vector2i(floori((center.x + reach) / GRASS_CELL), floori((center.z + reach) / GRASS_CELL))
	for cx in range(low.x, high.x + 1):
		for cz in range(low.y, high.y + 1):
			if not _digs_near.has(Vector2i(cx, cz)):
				_digs_near[Vector2i(cx, cz)] = []
			_digs_near[Vector2i(cx, cz)].append(dig)
			var inst: MultiMeshInstance3D = _grass_cells.get(Vector2i(cx, cz))
			if inst == null:
				continue
			var mm := inst.multimesh
			var local := center - inst.position
			for k in mm.instance_count:
				if mm.get_instance_transform(k).origin.distance_to(local) < reach:
					# A zero basis draws nothing; MultiMesh has no way to drop one instance.
					mm.set_instance_transform(k, Transform3D(Basis().scaled(Vector3.ZERO), local))


## The road through this chunk: one straight voxel stretch, then bent along the road's curve
## and slope vertex by vertex, so it has no joints, no steps on climbs and no staircase
## edges on bends. Faces are kept short so the bend follows the curve. The car drives on
## the terrain levelled just under it.
func _add_road(node: Node3D, i: int, span: Vector2) -> void:
	var road := _heights.road
	if road == null:
		return
	# No road behind where it starts (in the start tunnel, at the cave-in).
	span.y = minf(span.y, road.z_start())
	if span.y - span.x < 1.0:
		return
	# Short pieces, so a crater re-meshes only the piece it is in.
	var pieces := ceili((span.y - span.x) / ROAD_PIECE)
	var length := (span.y - span.x) / pieces
	for p in pieces:
		var mid := span.x + length * (p + 0.5)
		var model := VoxRoad.new().build({"seed": hash([_seed, i, p]), "length": length, "voxel": ROAD_VOXEL, "z_phase": mid})
		var inst := MeshInstance3D.new()
		var entry := {"model": model, "mid": mid, "cx": road.x_at(mid), "half_length": length / 2.0, "mesh": inst}
		inst.position = Vector3(entry["cx"], 0.0, mid)
		node.add_child(inst)
		_roads[i * ROADS_PER_CHUNK + p] = entry
		# Only craters that reach this piece; carving is the expensive part.
		for d in _digs:
			if absf(d.z - mid) <= length / 2.0 + d.w:
				_carve_road(entry, Vector3(d.x, d.y, d.z), d.w)
		_mesh_road(entry)


## Bends the road model along the road and puts it on its mesh instance.
func _mesh_road(entry: Dictionary) -> void:
	var road := _heights.road
	var model: VoxelModel = entry["model"]
	var inst: MeshInstance3D = entry["mesh"]
	VoxShading.ensure()
	var arrays := model.mesh_arrays_bendable(int(ROAD_BEND_STEP / ROAD_VOXEL))
	if arrays.is_empty():
		inst.mesh = null
		return
	var mid: float = entry["mid"]
	var cx: float = entry["cx"]
	var vertices: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
	# Vertices sit on the voxel grid, so the road's line and height are looked up once per
	# grid row instead of once per vertex (hundreds of thousands of them).
	var start := -float(entry["half_length"]) - ROAD_VOXEL
	var rows := ceili((float(entry["half_length"]) * 2.0 + ROAD_VOXEL * 2.0) / ROAD_VOXEL) + 1
	var row_x := PackedFloat32Array()
	var row_y := PackedFloat32Array()
	row_x.resize(rows)
	row_y.resize(rows)
	for r in rows:
		var z := mid + start + r * ROAD_VOXEL
		row_x[r] = road.x_at(z) - cx
		row_y[r] = road.height_at(z) - ROAD_LIFT
	for k in vertices.size():
		var v := vertices[k]
		var r := clampi(roundi((v.z - start) / ROAD_VOXEL), 0, rows - 1)
		# The bed sinks into the ground; the surface stands a few centimetres proud.
		vertices[k] = Vector3(row_x[r] + v.x, row_y[r] + v.y, v.z)
	arrays[Mesh.ARRAY_VERTEX] = vertices
	var mesh := ArrayMesh.new()
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	mesh.surface_set_material(0, VoxGenerator.material())
	inst.mesh = mesh


## Takes a crater out of a road piece, with a scorched ring of broken asphalt round it.
## Returns false when the crater does not reach this piece.
func _carve_road(entry: Dictionary, center: Vector3, radius: float) -> bool:
	var road := _heights.road
	var mid: float = entry["mid"]
	var local_z := center.z - mid
	if absf(local_z) > float(entry["half_length"]) + radius:
		return false
	var local := Vector3(center.x - road.x_at(center.z), center.y - road.height_at(center.z) + ROAD_LIFT, local_z)
	if absf(local.x) > ROAD_REACH + radius or local.y - radius > ROAD_LIFT + 0.5:
		return false
	var model: VoxelModel = entry["model"]
	var rng := RandomNumberGenerator.new()
	rng.seed = hash(center)
	model.paint_ellipsoid(local, Vector3.ONE * (radius + ROAD_SCORCH), ROAD_SCORCH_COLOUR, 0.4, rng.seed)
	model.carve_ellipsoid(local, Vector3.ONE * radius)
	# Bites out of the rim so the hole is torn asphalt, not a clean circle.
	for b in ROAD_RIM_BITES:
		var angle := TAU * (b + rng.randf_range(-0.3, 0.3)) / ROAD_RIM_BITES
		var bite := radius * rng.randf_range(0.2, 0.45)
		var at := local + Vector3(cos(angle), 0.0, sin(angle)) * radius * rng.randf_range(0.8, 1.05)
		model.paint_ellipsoid(at, Vector3.ONE * (bite + ROAD_SCORCH), ROAD_SCORCH_COLOUR, 0.4, rng.seed + b)
		model.carve_ellipsoid(at, Vector3.ONE * bite)
	return true


## Clients: a crater on the road breaks the road too, not just the ground under it.
func dig_road(center: Vector3, radius: float) -> void:
	for i: int in _roads:
		if _carve_road(_roads[i], center, radius):
			_roads_dirty[i] = true


## Everything a new crater takes with it: grass and the road over it.
func on_dug(center: Vector3, radius: float) -> void:
	clear_grass(center, radius)
	if _visual:
		var on_road := _heights.road != null and _heights.road.distance(center.x, center.z) < _heights.road.half_width
		dig_road(center, radius)
		# Bigger holes throw more; a bullet's scrape throws a pinch.
		var cfg := VoxelDebris.config(&"crater")
		if not cfg.is_empty():
			var count := clampi(int(radius * radius * float(cfg["count_per_m2"])), int(cfg["count_min"]), int(cfg["count"]))
			VoxelDebris.burst(self, center + Vector3.UP * 0.3, Vector3.UP, ASPHALT_CHIPS if on_road else DIRT, &"crater", count, float(cfg["speed"]) + radius * float(cfg["speed_per_metre"]))


func _grass_mesh() -> Mesh:
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	st.set_normal(Vector3.UP)
	# A tuft of five thin blades fanned around the centre. Each blade is written with both
	# windings and an up normal, instead of disabling culling: Godot flips the normal on
	# back faces, which lights them from below and turns half the grass black.
	for i in 5:
		var angle := TAU * float(i) / 5.0
		var side := Vector3(cos(angle), 0.0, sin(angle)) * 0.06
		var lean := Vector3(cos(angle + 0.6), 0.0, sin(angle + 0.6)) * 0.12
		var tip := Vector3.UP * 0.35 + lean
		for tri in [[-side, side, tip], [side, -side, tip]]:
			for v: Vector3 in tri:
				st.add_vertex(v)
	var out := st.commit()
	var wind := ShaderMaterial.new()
	wind.shader = load("res://modules/world/shaders/grass.gdshader")
	out.surface_set_material(0, wind)
	return out


## Server: a bullet hit `body` at `point`. Once a trunk has taken enough, returns
## {id, cut} for felling it; otherwise null.
func server_shoot_tree(body: Node, point: Vector3) -> Variant:
	var id: Variant = tree_at(body, point)
	if not id is Vector2i:
		return null
	var out: Variant = _damage.server_shoot(id, point)
	if out is Dictionary:
		(out as Dictionary)["id"] = id
	return out


## Server: the standing trees an explosion at `center` brings down, each with the way it
## falls (away from the blast), where it is cut and the chunk the blast takes out of it.
func server_blast_trees(center: Vector3, radius: float) -> Dictionary[Vector2i, Dictionary]:
	var out: Dictionary[Vector2i, Dictionary] = {}
	var reach := radius * float(_cfg["tree_blast_reach"])
	for i: int in _trees:
		var trees: Array = _trees[i]
		for t in trees.size():
			var id := Vector2i(i, t)
			var at: Vector3 = (trees[t] as Dictionary)["at"]
			if _damage.is_felled(id) or at.distance_to(center) > reach:
				continue
			var hit := _damage.server_blast(id, center, radius)
			hit["direction"] = at - center
			out[id] = hit
	return out


## Clients: splinters and a bite where a bullet went into a trunk.
func bite_tree(body: Node, point: Vector3, from: Vector3) -> void:
	var id: Variant = tree_at(body, point)
	if id is Vector2i:
		_damage.bite(id, point, from)


## The standing tree whose trunk is nearest `point` in the chunk `body` belongs to, or null.
func tree_at(body: Node, point: Vector3) -> Variant:
	if body == null or not body.has_meta(&"chunk"):
		return null
	var chunk := int(body.get_meta(&"chunk"))
	if not _trees.has(chunk):
		return null
	var best: Variant = null
	var best_d := INF
	var trees: Array = _trees[chunk]
	for t in trees.size():
		var tree: Dictionary = trees[t]
		var at: Vector3 = tree["at"]
		var d := Vector2(point.x - at.x, point.z - at.z).length()
		if d < float(tree["radius"]) + TREE_HIT_SLACK and d < best_d and not _damage.is_felled(Vector2i(chunk, t)):
			best = Vector2i(chunk, t)
			best_d = d
	return best


## Where a tree stands; null when its chunk is not loaded.
func tree_position(id: Vector2i) -> Variant:
	var tree := tree_record(id)
	return tree["at"] if not tree.is_empty() else null


## A loaded tree's record ({at, xform, trunk, leaves, radius, ...}), or empty.
func tree_record(id: Vector2i) -> Dictionary:
	if not _trees.has(id.x) or id.y >= (_trees[id.x] as Array).size():
		return {}
	return (_trees[id.x] as Array)[id.y]


## The generator, its values and meshes for the kind of tree `id` is.
func tree_variant(id: Vector2i) -> Dictionary:
	var tree := tree_record(id)
	return ((_pines if tree["kind"] == "pine" else _leafs) as Array)[int(tree["v"])]


func tree_count(chunk: int) -> int:
	return (_trees[chunk] as Array).size() if _trees.has(chunk) else 0


func chunk_node(i: int) -> Node3D:
	return _chunks.get(i)


## Drops a tree's standing copy from its MultiMeshes (a zero basis draws nothing;
## MultiMesh has no way to remove one instance).
func hide_standing_tree(id: Vector2i) -> void:
	var tree := tree_record(id)
	if tree.is_empty() or not _tree_meshes.has(id.x):
		return
	for node: Variant in (_tree_meshes[id.x] as Dictionary).get(tree["key"], []):
		(node as MultiMeshInstance3D).multimesh.set_instance_transform(int(tree["slot"]), Transform3D(Basis().scaled(Vector3.ZERO), Vector3.ZERO))


func is_felled(id: Vector2i) -> bool:
	return _damage.is_felled(id)


func felled() -> Dictionary[Vector2i, Dictionary]:
	return _damage.felled()


## Every machine: tree `id` is cut `cut` metres above its foot and its top falls towards
## `direction`; `blast` is a chunk an explosion took out of it (local centre, radius).
func fell_tree(id: Vector2i, direction: Vector3, cut: float = 1.0, blast: Vector4 = Vector4.ZERO, seconds_ago: float = 0.0) -> void:
	_damage.fell(id, direction, cut, blast, seconds_ago)


## Seconds since tree `id` fell.
func felled_age(id: Vector2i) -> float:
	return _damage.age(id)


## How dry a felled tree's top is by now, 0 (green) to 1 (bare branches).
func felled_wither(id: Vector2i) -> float:
	return _damage.wither_of(id)
