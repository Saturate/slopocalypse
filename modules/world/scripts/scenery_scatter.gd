class_name SceneryScatter
extends Node3D
## Trees, rocks, grass and the road, generated by code and streamed in chunks around whoever
## needs them. The world is long, so nothing is placed up front: each 64 m chunk along the
## road is laid out from its own seed when someone comes near and freed when everyone has
## left, so the server and every client get the same trees in the same places.
##
## The server builds only collision (tree trunks, rock hulls) around players and vehicles.
## Clients also build the visuals around their camera: a few voxel-kit variants of each
## kind, made once and reused through MultiMesh, a coarse version of each tree for distance,
## grass close by, and the road's voxel pieces.

@export_file("*.json") var config_path: String = "res://modules/world/data/world.json"

const REQUIRED := {"seed": TYPE_FLOAT, "trees_per_hectare": TYPE_FLOAT, "rocks_per_hectare": TYPE_FLOAT, "grass_per_m2": TYPE_FLOAT, "clear_radius": TYPE_FLOAT, "max_steepness": TYPE_FLOAT, "road_clearance": TYPE_FLOAT, "load_distance": TYPE_FLOAT, "collision_distance": TYPE_FLOAT, "grass_distance": TYPE_FLOAT, "tree_detail_distance": TYPE_FLOAT, "variants": TYPE_FLOAT}

const CHUNK := 64.0
## Chunks split across the width into cells, so distance culling works per cell.
const CELL := 64.0
const GRASS_CELL := 32.0
const ROAD_PIECE := 16.0
## The smoothed terrain sags a little past a dug sphere's edge, and the shader shows that
## fringe as dirt, so grass clears slightly wider than the hole.
const GRASS_CLEAR_MARGIN := 0.4
## Chunks built per frame at most, so walking into new ground never stalls a frame for long.
const BUILDS_PER_FRAME := 1
const TREE_NEAR_VOXEL := 0.15
const TREE_FAR_VOXEL := 0.45
const ROCK_VOXEL := 0.1
const ROAD_VOXEL := 0.1
## Rocks whose top is lower than this above the ground get no collision; feet clear them.
const STEP_OVER_HEIGHT := 0.3

var _heights: TerrainHeights
var _biomes: Biomes
var _cfg: Dictionary
var _seed := 0
var _visual := DisplayServer.get_name() != "headless"
var _chunks: Dictionary[int, Node3D] = {}
## Variant lists per kind: {near: Mesh, far: Mesh, height, trunk} for trees,
## {mesh: Mesh, shape: Shape3D, top} for rocks.
var _pines: Array[Dictionary] = []
var _leafs: Array[Dictionary] = []
var _rocks: Array[Dictionary] = []
var _grass_mesh_cached: Mesh
var _grass_cells: Dictionary[Vector2i, MultiMeshInstance3D] = {}
## Every dig so far, so chunks built later leave grass out of old craters too.
var _digs: Array[Vector4] = []


func _ready() -> void:
	var data: Variant = Data.load_json(config_path)
	if not data is Dictionary or not Data.require(config_path, data, TerrainHeights.REQUIRED):
		return
	var world: Dictionary = data
	if not world.has("scatter") or not Data.require(config_path + " scatter", world["scatter"], REQUIRED):
		return
	if not world.has("biomes") or not Data.require(config_path + " biomes", world["biomes"], Biomes.REQUIRED):
		return
	_cfg = world["scatter"]
	_seed = int(_cfg["seed"])
	_heights = TerrainHeights.new(world)
	_biomes = Biomes.new(world["biomes"], _heights.stages)
	_make_variants()
	# The spawn is ready before anyone arrives (the world waits on its collision).
	update_around([Vector3.ZERO], INF)


func _process(_delta: float) -> void:
	if _heights == null:
		return
	update_around(_focus_points(), BUILDS_PER_FRAME)


## Builds chunks near any of `points` (at most `budget` this call) and frees the ones far
## from all of them.
func update_around(points: Array[Vector3], budget: float) -> void:
	var reach: float = _cfg["load_distance"] if _visual else _cfg["collision_distance"]
	var wanted: Dictionary[int, bool] = {}
	for p in points:
		var first := _chunk_of(p.z + reach)
		var last := _chunk_of(p.z - reach)
		for i in range(maxi(first, 0), mini(last, _chunk_count() - 1) + 1):
			wanted[i] = true
	var built := 0
	# Nearest first, so the ground you stand on is never waiting behind the horizon.
	var order := wanted.keys()
	order.sort_custom(func(a: int, b: int) -> bool: return _nearest(a, points) < _nearest(b, points))
	for i: int in order:
		if _chunks.has(i):
			continue
		if built >= budget:
			break
		_chunks[i] = _build_chunk(i)
		built += 1
	for i: int in _chunks.keys():
		if not wanted.has(i) and _nearest(i, points) > reach + CHUNK:
			_free_chunk(i)


func loaded_chunks() -> Array[int]:
	var out: Array[int] = []
	out.assign(_chunks.keys())
	return out


func _focus_points() -> Array[Vector3]:
	var out: Array[Vector3] = []
	if _visual:
		var cam := get_viewport().get_camera_3d()
		if cam != null:
			out.append(cam.global_position)
	# Before a client has connected there is no peer to ask, and nothing to follow yet.
	if multiplayer.has_multiplayer_peer() and multiplayer.is_server():
		for group: StringName in [&"players", &"vehicles"]:
			for n in get_tree().get_nodes_in_group(group):
				if n is Node3D:
					out.append((n as Node3D).global_position)
	if out.is_empty():
		out.append(Vector3.ZERO)
	return out


func _chunk_count() -> int:
	return int(ceil(_heights.length / CHUNK))


## Chunk 0 starts behind the spawn at the near end; numbers grow down the road.
func _chunk_of(z: float) -> int:
	return floori((_heights.z_max() - z) / CHUNK)


func _chunk_z(i: int) -> Vector2:
	var near := _heights.z_max() - i * CHUNK
	return Vector2(near - CHUNK, near)


func _nearest(i: int, points: Array[Vector3]) -> float:
	var span := _chunk_z(i)
	var best := INF
	for p in points:
		best = minf(best, maxf(maxf(span.x - p.z, p.z - span.y), 0.0))
	return best


func _free_chunk(i: int) -> void:
	var node: Node3D = _chunks[i]
	_chunks.erase(i)
	for key: Vector2i in _grass_cells.keys():
		if _grass_cells[key].get_parent() == node:
			_grass_cells.erase(key)
	node.queue_free()


## A few variants of each kind, built once. The server needs rock hulls only.
func _make_variants() -> void:
	var count := int(_cfg["variants"])
	for v in count:
		var rock := VoxRock.new()
		var p := {"seed": _seed + 500 + v, "width": 1.0 + v * 0.35, "voxel": ROCK_VOXEL}
		var mesh := VoxGenerator.to_mesh(rock.build(p))
		var top := mesh.get_aabb().end.y
		_rocks.append({"mesh": mesh, "shape": mesh.create_convex_shape(true, true), "top": top})
		_pines.append(_tree(VoxPineTree.new(), {"seed": _seed + 100 + v, "height": 8.0 + v * 1.3}))
		_leafs.append(_tree(VoxLeafTree.new(), {"seed": _seed + 300 + v, "height": 6.5 + v * 1.0}))


func _tree(gen: VoxGenerator, p: Dictionary) -> Dictionary:
	var values := gen.with_defaults(p)
	var out := {"height": float(values["height"]), "trunk": float(values["trunk"])}
	if _visual:
		values["voxel"] = TREE_NEAR_VOXEL
		out["near"] = VoxGenerator.to_mesh(gen.build(values))
		values["voxel"] = TREE_FAR_VOXEL
		out["far"] = VoxGenerator.to_mesh(gen.build(values))
	return out


func _build_chunk(i: int) -> Node3D:
	var node := Node3D.new()
	node.name = "Chunk%d" % i
	add_child(node)
	var rng := RandomNumberGenerator.new()
	rng.seed = hash([_seed, i])
	var span := _chunk_z(i)
	var area := Rect2(_heights.extent().position.x, span.x, _heights.width, CHUNK)
	var collision := StaticBody3D.new()
	collision.name = "Collision"
	node.add_child(collision)
	# Per kind, variant and cell: the transforms for its MultiMesh.
	var placed: Dictionary = {}
	_place_trees(rng, area, collision, placed)
	_place_rocks(rng, area, collision, placed)
	if _visual:
		for key: Array in placed.keys():
			_add_instances(node, key, placed[key])
		_add_grass(node, rng, area)
		_add_road(node, i, span)
	return node


## A spot on gentle ground inside `area`, clear of the spawn and the road, kept with the
## probability `weight(x, z)` gives.
func _spot(rng: RandomNumberGenerator, area: Rect2, weight: Callable) -> Variant:
	for attempt in 6:
		var x := rng.randf_range(area.position.x + 4.0, area.end.x - 4.0)
		var z := rng.randf_range(area.position.y, area.end.y)
		if Vector2(x, z).length() < float(_cfg["clear_radius"]):
			continue
		if _heights.road != null and _heights.road.distance(x, z) < _heights.road.half_width + float(_cfg["road_clearance"]):
			continue
		if rng.randf() > float(weight.call(x, z)):
			continue
		var s := 1.0
		var dx := _heights.height_at(x + s, z) - _heights.height_at(x - s, z)
		var dz := _heights.height_at(x, z + s) - _heights.height_at(x, z - s)
		if Vector2(dx, dz).length() / (2.0 * s) > float(_cfg["max_steepness"]):
			continue
		return Vector3(x, _heights.height_at(x, z), z)
	return null


func _place_trees(rng: RandomNumberGenerator, area: Rect2, collision: StaticBody3D, placed: Dictionary) -> void:
	var tries := int(float(_cfg["trees_per_hectare"]) * area.get_area() / 10000.0)
	var weight := func(x: float, z: float) -> float:
		# Squared so only forest cores are dense; most woodland is open enough to see through.
		return maxf(pow(_biomes.forest(x, z), 2.0), 0.02) * (1.0 - _biomes.rock(x, z) * 0.7)
	for t in tries:
		var spot: Variant = _spot(rng, area, weight)
		if not spot is Vector3:
			continue
		var at: Vector3 = spot
		# Pines in the deep forest and up the rocky hills, leaf trees in the open.
		var pine := rng.randf() < 0.35 + _biomes.forest(at.x, at.z) * 0.5 + _biomes.rock(at.x, at.z) * 0.3
		var kinds := _pines if pine else _leafs
		var v := rng.randi_range(0, kinds.size() - 1)
		var tree: Dictionary = kinds[v]
		var scale := rng.randf_range(0.8, 1.2)
		var basis := Basis(Vector3.UP, rng.randf() * TAU).scaled(Vector3.ONE * scale)
		_put(placed, ["pine" if pine else "leaf", v, _cell_of(at)], Transform3D(basis, at + Vector3.DOWN * 0.2))
		var shape := CollisionShape3D.new()
		var capsule := CapsuleShape3D.new()
		capsule.radius = float(tree["trunk"]) * 0.4 * scale
		capsule.height = float(tree["height"]) * 0.6 * scale
		shape.shape = capsule
		shape.position = at + Vector3.UP * capsule.height * 0.5
		collision.add_child(shape)


func _place_rocks(rng: RandomNumberGenerator, area: Rect2, collision: StaticBody3D, placed: Dictionary) -> void:
	var tries := int(float(_cfg["rocks_per_hectare"]) * area.get_area() / 10000.0)
	var weight := func(x: float, z: float) -> float:
		return 0.05 + _biomes.rock(x, z) * 0.95
	for t in tries:
		var spot: Variant = _spot(rng, area, weight)
		if not spot is Vector3:
			continue
		var at: Vector3 = spot
		var v := rng.randi_range(0, _rocks.size() - 1)
		var rock: Dictionary = _rocks[v]
		# Rocky ground gets the big boulders.
		var scale := rng.randf_range(0.5, 1.1) + _biomes.rock(at.x, at.z) * rng.randf_range(0.0, 1.2)
		var basis := Basis(Vector3.UP, rng.randf() * TAU).scaled(Vector3.ONE * scale)
		var xform := Transform3D(basis, at + Vector3.DOWN * 0.1 * scale)
		_put(placed, ["rock", v, _cell_of(at)], xform)
		# Collision is the rock's own hull; stones lower than a step get none.
		if float(rock["top"]) * scale - 0.1 * scale < STEP_OVER_HEIGHT:
			continue
		var shape := CollisionShape3D.new()
		shape.shape = rock["shape"]
		shape.transform = xform
		collision.add_child(shape)


func _cell_of(at: Vector3) -> Vector2i:
	return Vector2i(floori(at.x / CELL), floori(at.z / CELL))


func _put(placed: Dictionary, key: Array, xform: Transform3D) -> void:
	if not placed.has(key):
		placed[key] = []
	(placed[key] as Array).append(xform)


## One MultiMesh per kind, variant and cell; trees get a detailed copy near and a coarse
## one far.
func _add_instances(node: Node3D, key: Array, transforms: Array) -> void:
	var kind: String = key[0]
	var v: int = key[1]
	var cell: Vector2i = key[2]
	var centre := Vector3((cell.x + 0.5) * CELL, 0.0, (cell.y + 0.5) * CELL)
	var detail: float = _cfg["tree_detail_distance"]
	if kind == "rock":
		var rock := _multimesh(node, _rocks[v]["mesh"], transforms, [], centre)
		rock.visibility_range_end = float(_cfg["load_distance"])
		return
	var tree: Dictionary = (_pines if kind == "pine" else _leafs)[v]
	var near := _multimesh(node, tree["near"], transforms, [], centre)
	near.visibility_range_end = detail
	near.visibility_range_end_margin = 8.0
	var far := _multimesh(node, tree["far"], transforms, [], centre)
	far.visibility_range_begin = detail
	far.visibility_range_begin_margin = 8.0
	far.visibility_range_end = float(_cfg["load_distance"]) + CHUNK


## Instances are stored relative to `centre`, where the node sits, so visibility ranges are
## measured from the cell rather than the world origin.
func _multimesh(node: Node3D, mesh: Mesh, transforms: Array, colours: Array, centre: Vector3) -> MultiMeshInstance3D:
	var mm := MultiMesh.new()
	mm.transform_format = MultiMesh.TRANSFORM_3D
	mm.use_colors = not colours.is_empty()
	mm.mesh = mesh
	mm.instance_count = transforms.size()
	var to_local := Transform3D(Basis.IDENTITY, -centre)
	for i in transforms.size():
		mm.set_instance_transform(i, to_local * (transforms[i] as Transform3D))
		if mm.use_colors:
			mm.set_instance_color(i, colours[i])
	var inst := MultiMeshInstance3D.new()
	inst.multimesh = mm
	inst.position = centre
	node.add_child(inst)
	return inst


func _add_grass(node: Node3D, rng: RandomNumberGenerator, area: Rect2) -> void:
	if _grass_mesh_cached == null:
		_grass_mesh_cached = _grass_mesh()
	var per_cell: Dictionary[Vector2i, Array] = {}
	var count := int(float(_cfg["grass_per_m2"]) * area.get_area())
	for i in count:
		var x := rng.randf_range(area.position.x, area.end.x)
		var z := rng.randf_range(area.position.y, area.end.y)
		# Thick in meadows, thin on the forest floor, on rock and never on the road.
		var keep := 1.0 - _biomes.forest(x, z) * 0.8 - _biomes.rock(x, z) * 0.6
		if rng.randf() > keep:
			continue
		if _heights.road != null and _heights.road.distance(x, z) < _heights.road.half_width + 0.5:
			continue
		var at := Vector3(x, _heights.height_at(x, z), z)
		if _in_old_dig(at):
			continue
		var s := rng.randf_range(0.5, 1.1)
		var xform := Transform3D(Basis(Vector3.UP, rng.randf() * TAU).scaled(Vector3(s, s * rng.randf_range(0.7, 1.4), s)), at)
		var green := Color(0.3, 0.36, 0.18).lerp(Color(0.44, 0.45, 0.25), rng.randf())
		var colour := green.lerp(Color(0.62, 0.55, 0.32), _biomes.dry(x, z) * 0.85)
		var cell := Vector2i(floori(x / GRASS_CELL), floori(z / GRASS_CELL))
		if not per_cell.has(cell):
			per_cell[cell] = [[], []]
		(per_cell[cell][0] as Array).append(xform)
		(per_cell[cell][1] as Array).append(colour)
	for cell: Vector2i in per_cell.keys():
		var centre := Vector3((cell.x + 0.5) * GRASS_CELL, 0.0, (cell.y + 0.5) * GRASS_CELL)
		var inst := _multimesh(node, _grass_mesh_cached, per_cell[cell][0], per_cell[cell][1], centre)
		inst.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		# Grass far away is noise; fade it out with distance to keep the horizon clean.
		inst.visibility_range_end = float(_cfg["grass_distance"])
		inst.visibility_range_end_margin = 10.0
		inst.visibility_range_fade_mode = GeometryInstance3D.VISIBILITY_RANGE_FADE_SELF
		_grass_cells[cell] = inst


func _in_old_dig(at: Vector3) -> bool:
	for d in _digs:
		if at.distance_to(Vector3(d.x, d.y, d.z)) < d.w + GRASS_CLEAR_MARGIN:
			return true
	return false


## Removes the grass a dug sphere took the ground out from under, so it doesn't float.
func clear_grass(center: Vector3, radius: float) -> void:
	_digs.append(Vector4(center.x, center.y, center.z, radius))
	var reach := radius + GRASS_CLEAR_MARGIN
	var low := Vector2i(floori((center.x - reach) / GRASS_CELL), floori((center.z - reach) / GRASS_CELL))
	var high := Vector2i(floori((center.x + reach) / GRASS_CELL), floori((center.z + reach) / GRASS_CELL))
	for cx in range(low.x, high.x + 1):
		for cz in range(low.y, high.y + 1):
			var inst: MultiMeshInstance3D = _grass_cells.get(Vector2i(cx, cz))
			if inst == null:
				continue
			var mm := inst.multimesh
			var local := center - inst.position
			for k in mm.instance_count:
				if mm.get_instance_transform(k).origin.distance_to(local) < reach:
					# A zero basis draws nothing; MultiMesh has no way to drop one instance.
					mm.set_instance_transform(k, Transform3D(Basis().scaled(Vector3.ZERO), local))


## The road's voxel pieces for this chunk, following the path and its elevation. The car
## drives on the terrain levelled just under them.
func _add_road(node: Node3D, i: int, span: Vector2) -> void:
	var road := _heights.road
	if road == null:
		return
	var gen := VoxRoad.new()
	var z := span.y
	var piece := 0
	while z > span.x + 0.01:
		var z1 := maxf(z - ROAD_PIECE, span.x)
		var mid := (z + z1) / 2.0
		var cx := road.x_at(mid)
		# Each piece is tilted to its slope, so a climb is a smooth ramp rather than a
		# staircase of voxel rows; the path only carries what bends away from that line.
		var y_mid := road.height_at(mid)
		var grade := (road.height_at(z) - road.height_at(z1)) / maxf(z - z1, 0.01)
		var low := INF
		var high := -INF
		var spread := 0.0
		for k in range(0, int(ROAD_PIECE) + 1):
			var lz := lerpf(z1, z, k / ROAD_PIECE) - mid
			var bend := road.height_at(mid + lz) - (y_mid + grade * lz)
			low = minf(low, bend)
			high = maxf(high, bend)
			spread = maxf(spread, absf(road.x_at(mid + lz) - cx))
		var p := {
			"seed": hash([_seed, i, piece]),
			"length": z - z1,
			"voxel": ROAD_VOXEL,
			"spread": spread + 0.5,
			"rise": high - low,
			"z_phase": mid,
			"x_of": func(lz: float) -> float: return road.x_at(mid + lz) - cx,
			"y_of": func(lz: float) -> float: return road.height_at(mid + lz) - (y_mid + grade * lz) - low,
		}
		var inst := MeshInstance3D.new()
		inst.mesh = VoxGenerator.to_mesh(gen.build(p))
		# Local +z climbs by `grade`; the bed sinks into the ground and the surface stands a
		# few centimetres proud.
		inst.transform = Transform3D(Basis(Vector3.RIGHT, -atan(grade)), Vector3(cx, y_mid + low - VoxRoad.BED - VoxRoad.SURFACE + 0.03, mid))
		node.add_child(inst)
		z = z1
		piece += 1


func _grass_mesh() -> Mesh:
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	st.set_normal(Vector3.UP)
	# A tuft of five thin blades fanned around the centre. Each blade is written with both
	# windings and an up normal, instead of disabling culling: Godot flips the normal on
	# back faces, which lights them from below and turns half the grass black.
	for i in 5:
		var angle := TAU * float(i) / 5.0
		var side := Vector3(cos(angle), 0.0, sin(angle)) * 0.06
		var lean := Vector3(cos(angle + 0.6), 0.0, sin(angle + 0.6)) * 0.12
		var tip := Vector3.UP * 0.35 + lean
		for tri in [[-side, side, tip], [side, -side, tip]]:
			for v: Vector3 in tri:
				st.add_vertex(v)
	var out := st.commit()
	var wind := ShaderMaterial.new()
	wind.shader = load("res://modules/world/shaders/grass.gdshader")
	out.surface_set_material(0, wind)
	return out
